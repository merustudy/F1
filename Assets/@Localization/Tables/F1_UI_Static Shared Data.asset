    - rid: 8623673481061990403
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: The experience every survivor got (stage 27). {0} = the experience.
    - rid: 8623673481061990404
