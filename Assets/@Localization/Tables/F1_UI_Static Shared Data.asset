    - rid: 8623673479834370058
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'The second line of the inn''s plate past the last day: no
          day is left to rest.'
    - rid: 8623673479834370059
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: The bubble over the barracks. {0} = mercenaries in the roster,
