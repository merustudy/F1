    RefIds:
    - rid: 636489278608375832
      type: {class: DistributedUIDGenerator, ns: UnityEngine.Localization.Tables, asm: Unity.Localization}
      data:
        m_CustomEpoch: 1790762675498
    - rid: 636489278608375835
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Generic confirm button.
    - rid: 636489278608375836
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Generic cancel button.
    - rid: 636489278608375839
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Working title shown on the title screen.
    - rid: 636489278608375840
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Starts a fresh run.
    - rid: 636489278608375841
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Continues the run in progress.
    - rid: 636489278608375842
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Button that switches the language. {0} = name of the current
          language.
    - rid: 636489278608375843
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Name of this language written in itself.
    - rid: 636489279218909184
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Generic continue button.
    - rid: 636489279218909185
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Shown in place of an empty list of names.
    - rid: 636489279218909186
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Closes the game.
    - rid: 636489279218909187
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Asked before a new run replaces the run in progress.
    - rid: 636489279218909188
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Header of the lobby screen.
    - rid: 636489279218909189
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = current day. {1} = total days.'
    - rid: 636489279218909190
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Header of the mercenary list.
    - rid: 636489279218909191
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = fatigue (0 is fresh; it builds up on expeditions).
          {1} = maximum.'
    - rid: 636489279218909192
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Takes a mercenary out of the party.
    - rid: 636489279218909193
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Header of the expedition panel.
    - rid: 636489279218909194
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = name of the dungeon''s affinity.'
    - rid: 636489279218909195
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = days the dungeon takes.'
    - rid: 636489279218909196
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = times this dungeon was cleared.'
    - rid: 636489279218909197
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Header of the party preview.
    - rid: 636489279218909198
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Shown for a row with nobody in it.
    - rid: 636489279218909199
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = how much fatigue comes down. {1} = days that pass.'
    - rid: 636489279218909200
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Starts the expedition.
    - rid: 636489279218909201
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: The party can leave.
    - rid: 636489279218909202
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = minimum party size.'
    - rid: 636489279218909204
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = names of the dead.'
    - rid: 636489279218909205
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: No mercenary is left alive.
    - rid: 636489279218909206
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = day the run ended.'
    - rid: 636489279218909207
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Goes back to the title screen.
    - rid: 636489279218909208
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = floor of the last cleared node. {1} = number of floors.'
    - rid: 636489279218909209
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Label of a battle node.
    - rid: 636489279218909210
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Label of the boss node.
    - rid: 636489279218909211
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Shown until a node is selected.
    - rid: 636489279218909212
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = floor. {1} = node kind.'
    - rid: 636489279218909216
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Starts the battle at the selected node.
    - rid: 636489279218909217
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: On the HP bar under a unit's feet. {0} = HP. {1} = max HP.
    - rid: 636489279218909219
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = item grade.'
    - rid: 636489279218909222
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: How to use the boards on the party side (Slice B stage 19).
    - rid: 636489279218909223
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = item name. {1} = tier (Item.Bronze etc.). {2} = grade.
          A Common item uses Item.TitlePlain.'
    - rid: 636489279218909224
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Item category: a weapon held in the hand.'
    - rid: 636489279218909225
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Item category: heals or strengthens.'
    - rid: 636489279218909226
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = seconds.'
    - rid: 636489279218909229
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = target. {1} = amount.'
    - rid: 636489279218909230
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = target. {1} = amount.'
    - rid: 636489279218909231
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = target. {1} = amount.'
    - rid: 636489279218909232
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = target. {1} = stacks.'
    - rid: 636489279218909233
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Used as {0} of Effect.*. The enemy in row 1.
    - rid: 636489279218909235
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Used as {0} of Effect.*.
    - rid: 636489279218909236
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Used as {0} of Effect.*.
    - rid: 636489279218909237
