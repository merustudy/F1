    - rid: 636489279218909239
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = amount.'
    - rid: 636489279218909240
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = amount.'
    - rid: 636489279218909243
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = battle time in seconds.'
