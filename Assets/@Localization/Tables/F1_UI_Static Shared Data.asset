    - rid: 8623673479834370081
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Row of the result window: how many died.'
    - rid: 8623673479834370082
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
