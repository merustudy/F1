    - rid: 8623673479834370053
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'The plate of the inn: resting and the treatment.'
    - rid: 8623673479834370054
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'The plate of the stagecoach: hiring.'
    - rid: 8623673479834370055
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'The plate of the gate: the way to the expedition screen.'
    - rid: 8623673479834370056
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: The gate's plate past the last day (Round 72).
    - rid: 8623673479834370057
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: The second line of the gate's plate past the last day. {0}
