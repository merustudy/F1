    m_Metadata:
      m_Items: []
  - m_Id: 2587403205206021
    m_Localized: "\uB123\uC744 \uCE78\uC744 \uB204\uB974\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 2587403205206024
    m_Localized: "\uC778\uBCA4\uD1A0\uB9AC\uC5D0 \uB123\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2894741271207936
    m_Localized: "\uC804\uB9AC\uD488 {0}"
    m_Metadata:
      m_Items:
      - rid: 636489278608375845
  - m_Id: 2894741283790848
    m_Localized: "\uC804\uB9AC\uD488\uC744 \uB204\uB974\uBA74 \uACE0\uB985\uB2C8\uB2E4.
      A: \uB0A8\uC740 \uC804\uB9AC\uD488\uC744 \uBAA8\uB450 \uC778\uBCA4\uD1A0\uB9AC\uC5D0
      \uB123\uC2B5\uB2C8\uB2E4. \uB0A8\uC740 \uAC83\uC740 \uACC4\uC18D\uC744 \uB204\uB974\uBA74
      \uB450\uACE0 \uAC11\uB2C8\uB2E4. \uC6B0\uD074\uB9AD\uC740 \uC544\uC774\uD15C
      \uC815\uBCF4\uC785\uB2C8\uB2E4."
