      m_Items: []
  - m_Id: 2552399930580992
    m_Localized: "\uC9C0\uC5ED \uCF54\uC778\uC73C\uB85C \uC544\uC774\uD15C\uC744
      \uC0AC\uB294 \uACF3\uC785\uB2C8\uB2E4. \uC2F8\uC6C0\uC740 \uC5C6\uC2B5\uB2C8\uB2E4."
