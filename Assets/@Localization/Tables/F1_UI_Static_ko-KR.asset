    m_Localized: "\uC800\uC7A5 \uD30C\uC77C\uC774 \uC190\uC0C1\uB418\uC5B4 \uC9C1\uC804
      \uC800\uC7A5\uC73C\uB85C \uB418\uB3CC\uB838\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17166291165185
    m_Localized: "\uC800\uC7A5\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uBC29\uAE08
      \uD55C \uD589\uB3D9\uC740 \uC544\uC9C1 \uD655\uC815\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.
      \uB514\uC2A4\uD06C \uACF5\uAC04\uACFC \uD3F4\uB354 \uAD8C\uD55C\uC744 \uD655\uC778\uD55C
      \uB4A4 \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 17166291165186
    m_Localized: "\uB2E4\uC2DC \uC2DC\uB3C4"
    m_Metadata:
      m_Items: []
