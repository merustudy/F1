    m_Metadata:
      m_Items:
      - rid: 636489278608375845
  - m_Id: 9766393864229
    m_Localized: "\uC544\uC774\uD15C\uC744 \uB204\uB974\uBA74 \uC9D1\uACE0, \uCE78\uC744
      \uB204\uB974\uBA74 \uB193\uC2B5\uB2C8\uB2E4(\uACB9\uCE5C \uD558\uB098\uB294
      \uC778\uBCA4\uD1A0\uB9AC\uB85C). \uB4E0 \uCC44\uB85C \uC6B0\uD074\uB9AD\xB7\uD720\xB7R:
      \uB3CC\uB9AC\uAE30. \uC55E\uC73C\uB85C\uC640 \uB4A4\uB85C\uB294 \uC606 \uC5F4\uC758
      \uC6A9\uBCD1\uACFC \uC790\uB9AC\uB97C \uBC14\uAFC9\uB2C8\uB2E4."
