    m_Metadata:
      m_Items:
      - rid: 636489278608375845
  - m_Id: 9766393864291
    m_Localized: "{0} \u2014 {1}\uCD08\uC5D0 \uBE48\uC0AC \u2192 {6}\uBC88 \uB9DE\uC544
      \uC720\uC608\uAC00 \uAE68\uC9D0 \u2192 {2}\uCD08\uC5D0 \uC0AC\uB9DD. \uB9C8\uC9C0\uB9C9
